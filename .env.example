# Simple Media Downloader Bot Configuration
# Created for sourcio.ir

# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567
BOT_USERNAME=your_bot_username

# Admin Telegram Numeric IDs (comma-separated, get via @userinfobot)
ADMIN_IDS=123456789,987654321

# Database URL (SQLite default, zero setup needed)
DATABASE_URL=sqlite:///data/bot.db

# Locale (fa / en)
DEFAULT_LOCALE=fa

# Daily Download Limits
USER_LIMIT_ENABLED=true
DAILY_USER_DOWNLOAD_LIMIT=10
GROUP_LIMIT_ENABLED=true
DAILY_GROUP_DOWNLOAD_LIMIT=50

# Cooldowns in seconds between requests
USER_COOLDOWN_SECONDS=10
GROUP_COOLDOWN_SECONDS=20

# Advanced Network & Cookie settings (Optional)
FFMPEG_PATH=
YOUTUBE_COOKIES_PATH=data/cookies.txt
PROXY_URL=
TELEGRAM_API_BASE=
